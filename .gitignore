# ============================================================
# 休伯利安（XBLA）电商导购与售后 RAG 平台 —— Git 忽略规则
#
# 规则来源：CLAUDE.md 第五节「安全约束」
#   - API Key 绝不提交到 git
#   - application-local.yml 必须忽略
#
# 这个文件必须在第一次 commit 之前就位，否则密钥会进入 git 历史，
# 之后即使删掉文件也清不干净（历史里还在）。
# ============================================================


# ------------------------------------------------------------
# 密钥与本地配置 ★最重要★
# ------------------------------------------------------------
# 本地私有配置：存放 DeepSeek / 硅基流动的 API Key、数据库密码
application-local.yml
application-local.yaml
application-*-local.yml
application-*-local.yaml

# 环境变量文件
.env
.env.local
.env.*.local

# 证书与密钥文件
*.pem
*.key
*.p12
*.jks
*.keystore


# ------------------------------------------------------------
# Java / Maven
# ------------------------------------------------------------
target/
build/
out/
*.class
*.jar
*.war
*.ear
*.nar

# Maven 构建时产生的临时文件
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar


# ------------------------------------------------------------
# IDE — IntelliJ IDEA
# ------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
out/


# ------------------------------------------------------------
# IDE — VS Code
# ------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json


# ------------------------------------------------------------
# IDE — Eclipse
# ------------------------------------------------------------
.classpath
.project
.settings/
.factorypath
.apt_generated/


# ------------------------------------------------------------
# 前端（阶段 8：Vue 3 + Vite），目录为 web/
# ------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
*.local

# npm / pnpm / yarn 日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# 前端测试覆盖率
coverage/
.nyc_output/


# ------------------------------------------------------------
# Python（评测脚本 scripts/ 下的 RAGAS 相关）
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# 虚拟环境
.venv/
venv/
env/
ENV/

# 打包产物
*.egg-info/
.eggs/
dist/
build/

# Jupyter
.ipynb_checkpoints/


# ------------------------------------------------------------
# 运行时产物
# ------------------------------------------------------------
# 日志
logs/
*.log
!docs/**/*.log

# 上传的文档原件（阶段 3 文档入库用，体积大且可重新生成）
storage/
uploads/
data/uploads/

# ⚠️ 注意 data/corpus/ 是【故意不忽略】的：
#   那是 scripts/generate_corpus.py 生成的仿真语料，一共 6 份约 60KB。
#   提交它是有意为之——别人克隆仓库后不装 Python 依赖也能直接
#   POST /api/kb/documents/scan 把语料灌进去，看到完整链路跑通。
#   而 data/uploads/ 装的是运行时上传的文件，可能含隐私数据且体积不可控，必须忽略。

# Python 评测中间结果
eval_results/
*.eval.tmp


# ------------------------------------------------------------
# 操作系统
# ------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
._*

# Linux
*~
.directory


# ------------------------------------------------------------
# 其他
# ------------------------------------------------------------
# 压缩包（除非明确需要版本管理的）
*.zip
*.tar.gz
*.rar
*.7z
!docs/**/*.zip

# 临时文件
*.tmp
*.temp
*.bak
*.swp
*~
