<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      parent：继承 Spring Boot 的父 POM。
      它的作用是「统一版本管理」——父 POM 里预先定义了几百个常用依赖的版本号，
      这样下面 <dependencies> 里大部分依赖都不用写 <version>，避免版本打架。
      这是 Spring Boot 项目最核心的一个约定。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/> <!-- 留空表示去仓库找，而不是找本地相对路径 -->
    </parent>

    <groupId>com.xbla</groupId>
    <artifactId>xbla-rag</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>xbla-rag</name>
    <description>休伯利安（XBLA）电商导购与售后 RAG 平台</description>

    <properties>
        <!-- JDK 21 LTS。CLAUDE.md 里固定这个版本，不随 Spring Boot 默认值走 -->
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!--
          Apache Tika 版本。抽成属性是因为下面有两个 artifact 必须版本一致
          （tika-parsers-standard-package 和 tika-core），
          分开写两遍迟早会出现「改了一个忘了另一个」。

          ★ 为什么是 3.3.2 而不是最新的 4.0.0：见下面 dependency 里的详细说明
        -->
        <tika.version>3.3.2</tika.version>

        <!--
          MCP 官方 Java SDK 版本（阶段 5.8 引入）。

          ★ 抽成属性是因为下面有两个 artifact 必须版本严格一致
            （mcp-core 和 mcp-json-jackson2），分两处写迟早会漂移。
        -->
        <mcp-sdk.version>2.0.1</mcp-sdk.version>
    </properties>

    <!--
      dependencyManagement：这里只「声明版本」，不真正引入依赖。
      真正引入靠下面 <dependencies> 里写 groupId + artifactId（不写 version）。

      这里 import 了 resilience4j 的 BOM（Bill of Materials，物料清单），
      作用是让下面所有 resilience4j-* 依赖版本天然一致，且都不用再写版本号。

      ★ 为什么必须自己 import？
        Spring Boot 3.5.16 的父 POM 里【没有】托管 resilience4j。
        这一点是查本地 ~/.m2 里的 spring-boot-dependencies-3.5.16.pom 逐行确认的，
        不是凭记忆。不写这个 BOM 又不写版本号的话，Maven 会直接报
        "'dependencies.dependency.version' for io.github.resilience4j:xxx:jar is missing"。
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-bom</artifactId>
                <version>2.4.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!--
          spring-boot-starter-web
          作用：引入 Spring MVC + 内嵌 Tomcat + Jackson(JSON 序列化)。
          没有它，项目就只是个普通 Java 程序，起不了 HTTP 服务。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
          spring-boot-starter-validation
          作用：参数校验。让 @NotBlank / @NotNull 这类注解真正生效。
          controller 层做参数校验要用（CLAUDE.md 约定 controller 只做参数校验和响应封装）。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          spring-boot-starter-actuator
          作用：暴露运维接口，最常用的是 /actuator/health。
          阶段 0 的验收标准「访问健康检查接口返回正常」就是靠它。
          后面接入 PostgreSQL 和 Redis 后，它会自动把这两个组件的连通状态
          也汇总到 /actuator/health 里，一眼就能看出谁挂了。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
          Lombok
          作用：编译期生成 getter/setter/toString/构造器，让实体类只保留字段声明。
          没有它，17 个实体要多写 5000+ 行样板代码，真正重要的字段定义反而被淹没。

          <optional>true</optional>：表示「这个依赖不传递给引用本项目的其他项目」。
          Spring Boot 官方脚手架生成的项目都是这么配的。

          ⚠️ IDE 必须装 Lombok 插件才能识别生成的 getter/setter：
             - IntelliJ IDEA：2020.3+ 版本已内置，无需额外安装
             - VS Code：需要装 "Lombok Annotations Support for VS Code" 扩展
             不装的话 IDE 会飘红提示「找不到 getXxx()」，但 Maven 编译是正常的。
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
          spring-boot-starter-test
          作用：测试框架（JUnit 5 + Mockito + AssertJ）。
          <scope>test</scope> 表示只在测试时引入，不会打进最终的可运行 jar。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          以下依赖于阶段 0 的 0.8 启用（docker-compose 起中间件之后）
          注：XML 注释内不能出现连续两个短横线，所以分隔线用的是等号
        -->
        <!-- ================================================== -->

        <!--
          spring-boot-starter-data-redis
          作用：Redis 客户端。Spring Boot 自动配置 Lettuce 连接池。
          接入后 /actuator/health 会多出一个 redis 组件，
          它的 UP/DOWN 就是「Spring Boot 能否连通 Redis」的直接证据。
          用途：阶段 2 做缓存/限流，阶段 6 做分布式信号量与排队队列。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!--
          mybatis-plus-spring-boot3-starter
          ★ 注意 artifactId 里的 spring-boot3 —— MyBatis-Plus 针对
            Spring Boot 3 单独发了 starter，用错成 mybatis-plus-boot-starter
            会因 jakarta 命名空间不兼容而起不来。
          作用：免写 SQL 的 ORM。继承 BaseMapper 就自带增删改查。
          版本 3.5.17 是查 Maven 中央仓库确认过的最新版，不是凭记忆写的。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>3.5.17</version>
        </dependency>

        <!--
          postgresql 驱动
          <scope>runtime</scope>：编译时用不到（代码里不直接 import 驱动类，
          只通过 JDBC URL 让 DriverManager 去加载），只在运行时需要。
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          Flyway 数据库迁移
          作用：把建表/改表写成带版本号的 SQL 文件，应用启动时自动执行没跑过的那些，
                并在数据库里留下执行记录（flyway_schema_history 表）。
          为什么需要：手工执行 SQL 没有状态，换台机器或过两周就不知道跑到哪了。

          flyway-core 是引擎，flyway-database-postgresql 是 PostgreSQL 方言支持。
          Flyway 10 起把各数据库的支持拆成了独立模块，两个都要引。
          ⚠️ 只引 flyway-core 会报 "Unsupported Database: PostgreSQL"。
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!--
          以下依赖于阶段 2 启用（模型接入层 + 降级链）
        -->
        <!-- ================================================== -->

        <!--
          resilience4j-spring-boot3 —— 熔断器
          ★ artifactId 里的 spring-boot3 不能写成 spring-boot2，
            后者是给 Spring Boot 2 用的，引进来会因 jakarta 命名空间不兼容起不来。
          版本由上面的 resilience4j-bom 统一管理（2.4.0）。

          本项目【只用编程式 API】，不用 @CircuitBreaker 注解：
          - 注解的 fallback 链表达不了「流式已吐字就不能降级」这个边界
          - 注解把状态机藏在切面里，不符合项目「链路可逐行解释」的要求
        -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
        </dependency>

        <!--
          spring-boot-starter-aop —— AOP 支持

          ★ 表面看熔断器不需要它，但 resilience4j-spring-boot3 的自动配置类
            AbstractCircuitBreakerConfigurationOnMissingBean 上挂着
            @Condition(AspectJOnClasspathCondition.class)：类路径上没有 AspectJ 时，
            它可能干脆不装配，而日志里只有一行 WARN。
            这种「静默不装配」的坑排查成本极高（配置全都对，Bean 就是没有），
            所以直接把 AOP 引上，消除这份不确定性。

          另外我们还会自己 @Bean 一个 CircuitBreakerRegistry（见 ChatChainConfig）
          做双重保险；AOP 的另一个作用是让 /actuator/circuitbreakers 能列出熔断器实例。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!--
          spring-boot-configuration-processor —— 配置元数据生成器
          作用：编译期扫描 @ConfigurationProperties 类，生成
                META-INF/spring-configuration-metadata.json，
                让 IDE 在 application.yml 里对 xbla.llm.* 有自动补全和文档提示。

          <optional>true</optional>：只在编译期用，不传递给下游项目。

          ⚠️ 本项目配置是三层结构（providers / models / chat-chain），
             没有它就得对着代码手敲配置键，很容易拼错。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
          以下依赖于阶段 3 启用（RAG 核心 —— 文档入库）
        -->
        <!-- ================================================== -->

        <!--
          Apache Tika —— 多格式文档解析
          作用：喂给它一个 InputStream，它自动识别是 PDF / Word / Excel / Markdown
                还是纯文本，统一吐出正文。没有它就得自己写四个解析器
                （PDFBox 一套、POI 两套、Markdown 一套），还要处理编码探测。

          ★ 版本 3.3.2 必须显式写：
            Spring Boot 3.5.16 的 BOM 里【没有】托管 Tika（查本地
            spring-boot-dependencies-3.5.16.pom 确认，grep 命中数为 0），
            不写版本号 Maven 会直接报 "version is missing"。

          ★ 为什么不用 4.0.0（Maven Central 上的最新版）：
            4.x 是一次破坏性大版本升级，改动包括
              - SPI 签名变更：Parser.parse 的参数从 InputStream 改成 TikaInputStream
              - 配置格式从 XML 改成 JSON，旧的 TikaConfig XML API 整个删除
              - Metadata 的键全部加 tk: 前缀，且 set 保留键会抛异常
              - 默认开启 fork 解析（子进程隔离）
            这些都是「查不到现成答案」的坑。3.x 线仍在维护（3.3.2 是目前最新），
            本项目要的是链路可逐行解释，不是版本号最新。详见 docs/08 ADR-012。

          ★ tika-parsers-standard-package 而不是单独的解析器：
            tika-core 只有引擎，不含任何具体格式的解析器。
            standard-package 把 PDF / Office / HTML / 纯文本等常用解析器打成一包，
            代价是传递依赖较多（pdfbox、poi、commons-compress 等）。
            阶段 3 要覆盖 PDF/Word/Excel/MD 四种格式，用整包最省事。
        -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parsers-standard-package</artifactId>
            <version>${tika.version}</version>
        </dependency>

        <!--
          ★★ tika-core 必须【显式】再引一次，否则编译直接报「程序包 org.apache.tika.parser 不存在」。

          原因（实测，不是推测）：查 tika-parsers-standard-package-3.3.2.pom 发现
          tika-core 被声明成 <scope>provided</scope>，而 provided 作用域
          **不具备传递性** —— 上游依赖 provided 的包，下游拿不到。
          于是整包里只有一堆 tika-parser-*-module，唯独缺了核心引擎。

          实测证据：mvn dependency:tree 输出里 tika-parser-*-module 有 22 个，
          但 tika-core 一条都没有。

          ⚠️ tika-core 和上面整包的版本号必须严格一致。
             两个版本号不一样会出现「接口签名对不上」的诡异编译错误。
             这里靠 ${tika.version} 属性统一，改一处即可。
        -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
            <version>${tika.version}</version>
        </dependency>

        <!-- ================================================== -->
        <!--  阶段 5.8：MCP 官方 Java SDK（只用作 Client）        -->
        <!-- ================================================== -->

        <!--
          mcp-core —— 协议本体（传输层 + 客户端 + 服务端）。

          ★★ 为什么【不】直接依赖聚合包 io.modelcontextprotocol.sdk:mcp。

          查 mcp-2.0.1.pom（实测，不是推测）：它只做一件事 ——
          把 mcp-core 和 **mcp-json-jackson3** 捆在一起。而 Jackson 3
          （groupId 是 tools.jackson）和本项目正在用的 Jackson 2
          （com.fasterxml.jackson，Spring Boot 3.5 的默认值）**是两套并存的 API**。

          引进来不会编译报错（包名不同，能共存），代价是：
            - fat jar 里多一整个 JSON 库
            - 两个 ObjectMapper 同时存在，几年后没人说得清哪个在生效
            - 更要命的是**它不会被任何测试发现** —— 两条路都能跑

          所以显式依赖 mcp-core + mcp-json-jackson2，把 Jackson 3 挡在门外。

          ⚠️ 传输层用的是 JDK 自带的 java.net.http.HttpClient（实测 javap
             HttpClientStreamableHttpTransport 的字段类型），不额外引入
             OkHttp / Apache HttpClient —— 这是选它的一个隐性好处。
        -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp-core</artifactId>
            <version>${mcp-sdk.version}</version>
        </dependency>

        <!--
          mcp-json-jackson2 —— 告诉 SDK「用 Jackson 2 来序列化」。

          ★ 这个 jar 里只有 5 个类，但它是【必须】的：
            SDK 靠 java.util.ServiceLoader 在运行时查找
            McpJsonMapperSupplier 的实现（见 JacksonMcpJsonMapperSupplier）。
            只依赖 mcp-core 的话，运行时抛的是
            「No McpJsonMapperSupplier found」——一个看起来完全不像
            「缺依赖」的异常，堆栈里也不会提到 Jackson。
        -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp-json-jackson2</artifactId>
            <version>${mcp-sdk.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              spring-boot-maven-plugin
              作用：把项目打成一个「可执行的 fat jar」——里面连 Tomcat 一起打包，
              用 java -jar 就能直接跑，不需要额外装 Tomcat。
              同时它提供 mvn spring-boot:run 命令，开发时用这个启动最方便。
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
