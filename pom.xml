<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      parent：继承 Spring Boot 的父 POM。
      它的作用是「统一版本管理」——父 POM 里预先定义了几百个常用依赖的版本号，
      这样下面 <dependencies> 里大部分依赖都不用写 <version>，避免版本打架。
      这是 Spring Boot 项目最核心的一个约定。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/> <!-- 留空表示去仓库找，而不是找本地相对路径 -->
    </parent>

    <groupId>com.xbla</groupId>
    <artifactId>xbla-rag</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>xbla-rag</name>
    <description>休伯利安（XBLA）电商导购与售后 RAG 平台</description>

    <properties>
        <!-- JDK 21 LTS。CLAUDE.md 里固定这个版本，不随 Spring Boot 默认值走 -->
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencies>
        <!--
          spring-boot-starter-web
          作用：引入 Spring MVC + 内嵌 Tomcat + Jackson(JSON 序列化)。
          没有它，项目就只是个普通 Java 程序，起不了 HTTP 服务。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
          spring-boot-starter-validation
          作用：参数校验。让 @NotBlank / @NotNull 这类注解真正生效。
          controller 层做参数校验要用（CLAUDE.md 约定 controller 只做参数校验和响应封装）。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          spring-boot-starter-actuator
          作用：暴露运维接口，最常用的是 /actuator/health。
          阶段 0 的验收标准「访问健康检查接口返回正常」就是靠它。
          后面接入 PostgreSQL 和 Redis 后，它会自动把这两个组件的连通状态
          也汇总到 /actuator/health 里，一眼就能看出谁挂了。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
          Lombok
          作用：编译期生成 getter/setter/toString/构造器，让实体类只保留字段声明。
          没有它，17 个实体要多写 5000+ 行样板代码，真正重要的字段定义反而被淹没。

          <optional>true</optional>：表示「这个依赖不传递给引用本项目的其他项目」。
          Spring Boot 官方脚手架生成的项目都是这么配的。

          ⚠️ IDE 必须装 Lombok 插件才能识别生成的 getter/setter：
             - IntelliJ IDEA：2020.3+ 版本已内置，无需额外安装
             - VS Code：需要装 "Lombok Annotations Support for VS Code" 扩展
             不装的话 IDE 会飘红提示「找不到 getXxx()」，但 Maven 编译是正常的。
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
          spring-boot-starter-test
          作用：测试框架（JUnit 5 + Mockito + AssertJ）。
          <scope>test</scope> 表示只在测试时引入，不会打进最终的可运行 jar。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          以下依赖于阶段 0 的 0.8 启用（docker-compose 起中间件之后）
          注：XML 注释内不能出现连续两个短横线，所以分隔线用的是等号
        -->
        <!-- ================================================== -->

        <!--
          spring-boot-starter-data-redis
          作用：Redis 客户端。Spring Boot 自动配置 Lettuce 连接池。
          接入后 /actuator/health 会多出一个 redis 组件，
          它的 UP/DOWN 就是「Spring Boot 能否连通 Redis」的直接证据。
          用途：阶段 2 做缓存/限流，阶段 6 做分布式信号量与排队队列。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!--
          mybatis-plus-spring-boot3-starter
          ★ 注意 artifactId 里的 spring-boot3 —— MyBatis-Plus 针对
            Spring Boot 3 单独发了 starter，用错成 mybatis-plus-boot-starter
            会因 jakarta 命名空间不兼容而起不来。
          作用：免写 SQL 的 ORM。继承 BaseMapper 就自带增删改查。
          版本 3.5.17 是查 Maven 中央仓库确认过的最新版，不是凭记忆写的。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>3.5.17</version>
        </dependency>

        <!--
          postgresql 驱动
          <scope>runtime</scope>：编译时用不到（代码里不直接 import 驱动类，
          只通过 JDBC URL 让 DriverManager 去加载），只在运行时需要。
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          Flyway 数据库迁移
          作用：把建表/改表写成带版本号的 SQL 文件，应用启动时自动执行没跑过的那些，
                并在数据库里留下执行记录（flyway_schema_history 表）。
          为什么需要：手工执行 SQL 没有状态，换台机器或过两周就不知道跑到哪了。

          flyway-core 是引擎，flyway-database-postgresql 是 PostgreSQL 方言支持。
          Flyway 10 起把各数据库的支持拆成了独立模块，两个都要引。
          ⚠️ 只引 flyway-core 会报 "Unsupported Database: PostgreSQL"。
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              spring-boot-maven-plugin
              作用：把项目打成一个「可执行的 fat jar」——里面连 Tomcat 一起打包，
              用 java -jar 就能直接跑，不需要额外装 Tomcat。
              同时它提供 mvn spring-boot:run 命令，开发时用这个启动最方便。
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
